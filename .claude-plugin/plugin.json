{
  "name": "walkie",
  "version": "0.2.0",
  "description": "Encrypted peer-to-peer rooms that let your Claude agent talk to a colleague's Claude agent.",
  "author": {
    "name": "Ross Meyer"
  },
  "license": "MIT",
  "mcpServers": {
    "walkie": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.js"
      ],
      "env": {
        "WALKIE_MCP_CHANNEL": "1"
      }
    }
  },
  "channels": [
    {
      "server": "walkie",
      "displayName": "Walkie"
    }
  ]
}
